# Upstage 콘솔에서 발급. 실제 값은 .env에만 넣고 커밋하지 않는다.
UPSTAGE_API_KEY=

# 로그인 토큰·서명 URL 비밀키 (운영에서는 길고 무작위인 값)
SECRET_KEY=
# 첫 실행 때 만드는 계정 초기 비밀번호 (비어 있으면 그 계정은 만들지 않음)
SEED_PASSWORD_CLUB=
SEED_PASSWORD_WEMEET=
SEED_PASSWORD_ADMIN=
# 메일 수집 웹훅 비밀 키 (Cloudflare Email Worker가 X-Intake-Secret 헤더로 보냄)
INTAKE_SECRET=
# 이 시각(한국 시간) 이전에 받은 메일은 접수하지 않음. 예: 2026-10-30T12:30
INTAKE_SINCE=
# 원래 받은 담당자 주소 → 메일함 (프로그램 구분)
MANAGER_MAILBOXES=club_manager=,wemeet_manager=
# Gmail 임시 수집: Gmail 주소와 앱 비밀번호(Google 계정 → 보안 → 앱 비밀번호). 직접 넣는다
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_POLL_MINUTES=0
